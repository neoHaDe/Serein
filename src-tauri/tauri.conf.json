{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serein",
  "version": "1.0.0",
  "identifier": "dev.serein.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Serein",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#1a1b26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://nehade.xyz/updates/terminal/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QjUwNzE2MzY4NTY4QjcKUldTM2FJVTJGZ2UxcUZxS2dVUXd1M01raEZ1K2ZFSzQxdjlydEV0U0RnRE8wZnZrVzZycFI3KzAK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
